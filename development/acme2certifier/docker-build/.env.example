# =============================================================================
# .env.example — Variáveis de personalização do build
#
# Como usar:
#   cp .env.example .env
#   # editar .env com os valores do seu ambiente
#   bash build.sh          # o script lê o .env automaticamente
#
# ⚠️  Não commitar o .env com dados reais (adicionar ao .gitignore)
# =============================================================================

# ---------------------------------------------------------------------------
# Nome da CA — aparece no certificado e no Central Server X-Road
# Este é o nome que você digita no local.yaml de cada Security Server
# ---------------------------------------------------------------------------
CA_NAME="Test CA"
CA_ORG="Test"
OCSP_NAME="Test OCSP"
TSA_NAME="Test TSA"

# ---------------------------------------------------------------------------
# Versão do acme2certifier a instalar
# Verificar releases: https://github.com/grindsa/acme2certifier/releases
# ---------------------------------------------------------------------------
A2C_VER=0.35

# ---------------------------------------------------------------------------
# Tag da imagem Docker gerada
# ---------------------------------------------------------------------------
IMAGE_NAME="testca-dev"
IMAGE_TAG="1.0.0"

# ---------------------------------------------------------------------------
# AWS ECR — push para registry (deixar vazio para não fazer push)
# ---------------------------------------------------------------------------
AWS_REGION="sa-east-1"
ECR_ACCOUNT_ID=""
# ECR_ACCOUNT_ID="123456789012"
# Resultado: ${ECR_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${IMAGE_NAME}:${IMAGE_TAG}
